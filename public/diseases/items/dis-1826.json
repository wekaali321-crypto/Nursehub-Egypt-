 "sections": {
  "overview": {
   "ar": "<p>يبدأ بعمر 18-24 شهراً عند السيطرة على العضلات العاصرة الشرجية والبولية؛ الجسم غير جاهز قبل 18 شهراً (ليس 15 شهراً).</p>[[slot:dis-1826-toilet|التدريب على الحمام — رسم من إعداد الموقع|/diseases/img/dis-1826-toilet.svg]]"
  },
  "causes": {
   "ar": "<p>—</p>"
  },
  "signs": {
   "ar": "<ul><li>يتبع أوامر بسيطة (يتواصل ويتبع التعليمات)</li><li>يمشي ويجلس على المرحاض</li><li>يبقى 5-8 دقائق</li><li>يرفع ويخلع ملابسه</li></ul>"
  },
  "tests": {
   "ar": "<p>—</p>"
  },
  "treatment": {
   "ar": "<ul><li>الأمعاء أولاً ثم المثانة (حوالي 24 شهراً).</li></ul>"
  },
  "nursing": {
   "ar": "<ul><li>الاستعداد وليس العمر وحده.</li><li>لا تعاقب عند الخطأ؛ نظف وتابع فهي عملية تعلم.</li><li>المهمة الرئيسية للدارج.</li><li>سيطرة المثانة بعد الأمعاء.</li></ul>"
  },
  "redflags": {
   "ar": "<div class=\"cs-box cs-danger\"><strong>تنبيه</strong><ul><li>لا تبدأ قبل 18 شهراً</li></ul></div>"
  },
  "teaching": {
   "ar": "<ul><li>اصبري ولا تعاقبي.</li></ul>"
  }
 },
