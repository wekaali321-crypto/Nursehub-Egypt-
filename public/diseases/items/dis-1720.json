 "title": {
  "ar": "إنعاش المولود (NRP) والتهاب الأمعاء الناخر (NEC)",
  "en": "Neonatal Resuscitation & Necrotizing Enterocolitis"
 },
 "teaser": {
  "ar": "خطوات الإنعاش الأولية، قاعدة النبض للتهوية والتدليك، وNEC."
 },
 "chips": [
  {
   "ar": "NRP"
  },
