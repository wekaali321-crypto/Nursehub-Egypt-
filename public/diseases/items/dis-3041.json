 "sections": {
  "overview": {
   "ar": "<p>الارتجاع المثانوي الحالبي (VUR) رجوع البول من المثانة نحو الحالب والكلية، غالبًا بصمام معيب، فيبقى بالجسم ويسبب التهابات بولية وكلوية متكررة.</p>[[slot:dis-3041-vur|VUR: الآلية والمضاعفات — رسم من إعداد الموقع|/diseases/img/dis-3041-vur.svg]]"
  },
  "causes": {
   "ar": ""
  },
  "signs": {
   "ar": "<p>التهابات بولية متكررة وحمى؛ وقد يُرى استسقاء كلية (Hydronephrosis): تمدد الكلية بالبول المحتبس وقد يتلف الكلية.</p>"
  },
  "tests": {
   "ar": ""
  },
  "treatment": {
   "ar": "<p>جراحة تصحيحية؛ يتعافى المريض بأنبوب حالب يصرف من الكلية.</p>"
  },
  "nursing": {
   "ar": "<ul><li>تتبع <b>خرج البول</b>: لا بول = أولوية وأبلغ الطبيب فورًا.</li><li>العناية بأنبوب الحالب.</li><li>راقب علامات العدوى.</li></ul>"
  },
  "redflags": {
   "ar": "<div class=\"cs-box cs-danger\"><strong>أبلغ فورًا</strong><p>انعدام البول بعد الجراحة، حمى، ألم جنب.</p></div>"
  },
  "teaching": {
   "ar": ""
  }
 },
