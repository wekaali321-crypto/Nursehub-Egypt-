 "sections": {
  "overview": {
   "ar": "<p>يُختار المقياس حسب العمر. الأطفال 3-6 سنوات يرون الألم عقاباً أو يلومون غيرهم أو يظنون أنه سيختفي سحرياً (تفكير سحري).</p>[[slot:dis-1815-pain|مقاييس الألم — رسم من إعداد الموقع|/diseases/img/dis-1815-pain.svg]]"
  },
  "causes": {
   "ar": "<p>—</p>"
  },
  "signs": {
   "ar": "<table><thead><tr><th>المقياس</th><th>العمر</th><th>العناصر</th></tr></thead><tbody><tr><td>CRIES</td><td>0-6 أشهر</td><td>بكاء، حاجة للأكسجين، ارتفاع علامات حيوية، تعبير الوجه، أرق</td></tr><tr><td>FLACC</td><td>2 شهر-7 سنوات</td><td>الوجه، الساقان، النشاط، البكاء، قابلية التهدئة</td></tr><tr><td>الوجوه</td><td>3 سنوات فأكثر</td><td>0 لا ألم إلى 5 أسوأ ألم</td></tr><tr><td>الرقمي</td><td>5 سنوات فأكثر</td><td>0-10 مع OPQRST</td></tr></tbody></table>"
  },
  "tests": {
   "ar": "<ul><li>OPQRST: البدء، المحرّض، النوعية، الانتشار، الشدة، الزمن</li></ul>"
  },
  "treatment": {
   "ar": "<ul><li>راجع <a href=\"/diseases/dis-831\">دليل المسكنات</a>.</li></ul>"
  },
  "nursing": {
   "ar": "<ul><li>اختر المقياس حسب العمر.</li><li>طفل 4 سنوات: توقع عقاباً/لوماً للغير/اعتقاد بالسحر.</li><li>أعد التقييم بعد التدخل.</li></ul>"
  },
  "redflags": {
   "ar": "<div class=\"cs-box cs-danger\"><strong>بلّغ</strong><ul><li>ألم شديد لا يستجيب</li><li>بكاء حاد</li></ul></div>"
  },
  "teaching": {
   "ar": "<ul><li>شجّع الطفل على التعبير.</li></ul>"
  }
 },
