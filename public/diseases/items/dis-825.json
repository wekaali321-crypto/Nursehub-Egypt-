 "title": {
  "ar": "الألم المزمن: الأسباب والعلاج والدعم",
  "en": "Chronic Pain"
 },
 "teaser": {
  "ar": "ألم يستمر بعد زوال السبب الأول: الأسباب، الأعراض النفسية، مضادات الاكتئاب والقلق، العلاج الطبيعي والارتجاع الحيوي."
 },
 "chips": [
  {
   "ar": "4-6 شهور"
  },
  {
   "ar": "مضادات اكتئاب"
  },
  {
   "ar": "دعم نفسي"
  }
 ],
 "target": "diseases",
 "sections": {
  "overview": {
   "ar": "<p>الألم المزمن هو ألم يستمر بعد تحديد سببه الأول؛ قد يخف بعد 4-6 شهور أو يبقى بنفس الدرجة. التوقع غير جيد، لكن العلاجات المساعدة (Adjuvant) تخفف الأثر طويل المدى.</p>"
  },
  "causes": {
   "ar": "<ul><li>التهاب المفاصل</li><li>آلام الظهر</li><li>السرطان</li><li>الصداع</li><li>ألم عصبي (Neurogenic)</li><li>ألم نفسي المنشأ (Psychogenic)</li></ul>"
  },
  "signs": {
   "ar": "<ul><li>غضب</li><li>قلة الحركة</li><li>قلة الطاقة</li><li>اكتئاب</li><li>تململ أو قلق</li><li>شد العضلات</li></ul><p>وفي التقييم قد ترتفع النبض والضغط والتنفس، ويقاس الألم بمقياس الألم.</p>"
  },
  "tests": {
   "ar": "<ul><li>العلامات الحيوية قد ترتفع</li><li>مقاييس الألم</li></ul>"
  },
  "treatment": {
   "ar": "<ul><li>مضادات القلق (Anxiolytics)</li><li>مضادات الاكتئاب</li><li>مضادات الذهان (Neuroleptics)</li></ul><div class=\"cs-box cs-warning\"><strong>تحديث</strong><p>الأفيونات طويلة المدى تُستعمل بحذر وتقييم؛ الأساس العلاج متعدد الأنماط: أدوية عصبية (gabapentinoids، SNRIs، TCAs)، تمارين، علاج سلوكي معرفي.</p></div>"
  },
  "nursing": {
   "ar": "<div class=\"cs-flow\"><div class=\"cs-step\"><span class=\"cs-step-n\">1</span><div><strong>اسمع</strong><p>صدّق الألم، اسأل عن النوم والمزاج.</p></div></div><div class=\"cs-arrow\">↓</div><div class=\"cs-step\"><span class=\"cs-step-n\">2</span><div><strong>الدعم</strong><p>اقترح استشارة نفسية أو مجموعة دعم.</p></div></div><div class=\"cs-arrow\">↓</div><div class=\"cs-step\"><span class=\"cs-step-n\">3</span><div><strong>الحركة</strong><p>تمارين يومية، علاج طبيعي.</p></div></div><div class=\"cs-arrow\">↓</div><div class=\"cs-step\"><span class=\"cs-step-n\">4</span><div><strong>الاسترخاء</strong><p>تنفس عميق وتأمل وارتجاع حيوي.</p></div></div><div class=\"cs-arrow\">↓</div><div class=\"cs-step\"><span class=\"cs-step-n\">5</span><div><strong>تدليك</strong><p>وفق التعليمات.</p></div></div><div class=\"cs-arrow\">↓</div><div class=\"cs-step\"><span class=\"cs-step-n\">6</span><div><strong>التشخيصات</strong><p>ألم مزمن، يأس، تدني تقدير الذات الظرفي.</p></div></div></div>"
  },
  "redflags": {
   "ar": "<div class=\"cs-box cs-danger\"><strong>بلّغ:</strong><ul><li>أفكار إيذاء النفس أو يأس شديد</li><li>ألم جديد أو تغير شكل الألم</li><li>ضعف أو خدر أو فقد تحكم في البول</li></ul></div>"
  },
  "teaching": {
   "ar": "<ul><li>الألم المزمن يُدار ولا يُنتظر اختفاؤه سريعاً</li><li>مارس الرياضة الخفيفة يومياً</li><li>انضم لمجموعة دعم</li><li>خذ الأدوية بانتظام</li></ul>"
  }
 },
