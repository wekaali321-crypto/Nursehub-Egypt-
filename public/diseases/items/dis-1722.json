  "title": {
    "ar": "متلازمة الامتناع الوليدي NAS ومتلازمة الضائقة التنفسية RDS",
    "en": "Neonatal Abstinence Syndrome & Respiratory Distress Syndrome"
  },
  "teaser": {
    "ar": "NAS: أفيونيات ومدة الأعراض والتدخلات؛ RDS: Surfactant ونسبة L:S ومقياس سيلفرمان."
  },
  "chips": [
    {
