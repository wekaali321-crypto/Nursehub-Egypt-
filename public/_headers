# Cloudflare Pages / Netlify caching rules (ignored by Vercel, which uses vercel.json)
/course-img/*
  Cache-Control: public, max-age=2592000
/skills-img/*
  Cache-Control: public, max-age=2592000
/clinical-cases/img/*
  Cache-Control: public, max-age=2592000
/travel-ecg/*
  Cache-Control: public, max-age=2592000
/icon-*
  Cache-Control: public, max-age=604800
/NurseHub-Egypt.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="NurseHub-Egypt.apk"
  Cache-Control: public, max-age=0, must-revalidate
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/media/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static guide/case/table JSON: served from the edge, revalidated hourly (changes only with a deploy)
/diseases/items/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/diseases/index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/diseases/rx.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/clinical-cases/index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/clinical-cases/cases/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/diseases/img/*
  Cache-Control: public, max-age=2592000
