# انسخ هذا الملف إلى .env واملأ القيم

# --- Supabase (Project Settings -> API) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- بريد حساب المدير (مطلوب) ---
# يجب أولاً إنشاء حساب المدير في Supabase (Authentication -> Users -> Add
# user) بنفس هذا البريد وكلمة مرور قوية — لا يمكن إنشاؤه من المتصفح إطلاقاً.
# هذا المتغير يُقرأ في الواجهة (VITE_) لذا لا تضع فيه أي سرّ، بريد فقط.
VITE_ADMIN_EMAIL=

# ============================================================
# المتغيرات التالية سيرفر-فقط (Vercel Project Settings -> Environment
# Variables) — لا تضعها هنا ولا في أي ملف VITE_، ولا تُعرض للمتصفح إطلاقاً.
# ============================================================
#
# ADMIN_PASSWORD            كلمة مرور منفصلة تُستخدم فقط لتفعيل جلسة
#                           /api/admin-orders المميّزة (تتجاوز RLS بمفتاح
#                           service role). يُفضّل أن تكون نفس كلمة مرور
#                           حساب Supabase Auth الخاص بالمدير لتفادي الحيرة.
# ADMIN_SESSION_SECRET      سرّ عشوائي طويل (32+ بايت) لتوقيع جلسة
#                           /api/admin-* بصيغة HMAC.
# SUPABASE_URL              نفس رابط المشروع أعلاه (بدون بادئة VITE_).
# SUPABASE_SERVICE_ROLE_KEY مفتاح service role — سرّي جداً، يتجاوز RLS بالكامل.
#
# أسرار Edge Function (Supabase Dashboard -> Edge Functions -> send-push
# -> Secrets، أو supabase secrets set):
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY   لإرسال Web Push.
#   PUSH_INTERNAL_SECRET                   يجب أن تُطابق القيمة المخزّنة في
#                                          Supabase Vault باسم
#                                          push_internal_secret (راجع تقرير
#                                          الأمان لطريقة استرجاعها).
